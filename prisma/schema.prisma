// prisma/schema.prisma
// Prisma 7: a URL de conexão fica no prisma.config.ts (não no datasource).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Domínio 50/30/20
// ─────────────────────────────────────────────

enum Bucket {
  needs
  wants
  savings

  @@map("bucket")
}

model UserSettings {
  userId                String    @id @map("user_id")
  timezone              String    @default("America/Sao_Paulo")
  defaultIncomeCents    Int?      @map("default_income_cents")
  onboardedAt           DateTime? @map("onboarded_at") @db.Timestamptz(6)
  reminderEnabled       Boolean   @default(false) @map("reminder_enabled")
  reminderHour          Int       @default(20) @map("reminder_hour") // 0..23 (CHECK na migration)
  lastReminderSentOn    DateTime? @map("last_reminder_sent_on") @db.Date
  // Show the leftover leisure amount in the reminder text (off by default: the
  // notification is visible on the lock screen).
  reminderShowAmount    Boolean   @default(false) @map("reminder_show_amount")
  // Último período ("YYYY-MM") cujo resumo o usuário confirmou ter lido
  // (openspec/changes/add-monthly-summary D2).
  lastSummarySeenPeriod String?   @map("last_summary_seen_period") @db.Char(7)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model BudgetCycle {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id")
  period             String    @db.Char(7) // 'YYYY-MM'
  incomeCents        Int       @map("income_cents")
  needsLimitCents    Int       @map("needs_limit_cents")
  wantsLimitCents    Int       @map("wants_limit_cents")
  savingsLimitCents  Int       @map("savings_limit_cents")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // Carimbo de "contas fixas já aplicadas neste ciclo" (design.md D2).
  recurringAppliedAt DateTime? @map("recurring_applied_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([userId, period], name: "userId_period")
  @@map("budget_cycles")
}

model Expense {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id")
  cycleId            String   @map("cycle_id") @db.Uuid
  amountCents        Int      @map("amount_cents") // > 0 (CHECK na migration)
  description        String
  bucket             Bucket
  occurredOn         DateTime @map("occurred_on") @db.Date
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  recurringExpenseId String?  @map("recurring_expense_id") @db.Uuid

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle            BudgetCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  @@unique([recurringExpenseId, cycleId])
  @@index([cycleId, bucket])
  @@index([userId, occurredOn])
  @@map("expenses")
}

// ─────────────────────────────────────────────
// Contas fixas e lembrete diário
// ─────────────────────────────────────────────

model RecurringExpense {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id")
  description String
  amountCents Int       @map("amount_cents") // > 0 (CHECK na migration)
  bucket      Bucket
  dayOfMonth  Int       @map("day_of_month") // 1..31 (CHECK na migration)
  active      Boolean   @default(true)
  // Soft delete: a "deleted" template is kept (so the expenses it launched
  // keep their "Fixa" badge and link) but hidden and never applied again.
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([userId, active])
  @@map("recurring_expenses")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model DailyCheckin {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_checkins")
}

// ─────────────────────────────────────────────
// Métricas de uso (openspec/changes/add-usage-analytics)
// ─────────────────────────────────────────────

// Evento de produto. `props` NUNCA carrega descrição, valor, renda nem texto
// livre do usuário (design.md D4); os nomes e props válidos vivem no EventMap
// em lib/analytics/events.ts.
model Event {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  name      String
  props     Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@map("events")
}

// ─────────────────────────────────────────────
// Espelho local do usuário do Neon Auth.
//
// O Neon Auth (@neondatabase/auth, "auth only") é hospedado e não grava
// nada neste Postgres — sessão, conta OAuth e tokens de verificação vivem
// no serviço da Neon, não aqui. Os models Session/Account/Verification que
// existiam antes (pensados para Better Auth cru + prismaAdapter) nunca
// tiveram consumidor nenhum e foram removidos. `User` continua: é o que
// UserSettings/BudgetCycle/Expense referenciam via FK, e
// getSessionUserOrRedirect() (lib/auth/session.ts) o mantém espelhado.
// ─────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  settings     UserSettings?
  budgetCycles BudgetCycle[]
  expenses     Expense[]

  recurringExpenses RecurringExpense[]
  pushSubscriptions PushSubscription[]
  dailyCheckins     DailyCheckin[]
  events            Event[]

  @@map("user")
}
