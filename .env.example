# Neon connection strings and Auth URLs. `neon deploy` / `neon env pull`
# writes these into .env.local; this file documents them.
#
# DATABASE_URL — pooled connection (host ends in "-pooler"), used by the
# app at runtime through the Neon serverless driver adapter (see lib/db.ts).
DATABASE_URL="postgresql://user:password@ep-example-000000-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# DATABASE_URL_UNPOOLED — direct connection (no "-pooler"), used only by the
# Prisma CLI for migrations (see prisma.config.ts). DIRECT_URL is still
# accepted as a fallback.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example-000000.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon Auth (hosted, not backed by this app's own Postgres — see
# design.md D7), see lib/auth/server.ts.
NEON_AUTH_BASE_URL="https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"
# Generate with: openssl rand -base64 32 (not injected by Neon)
NEON_AUTH_COOKIE_SECRET=""

# Name of the Neon branch DATABASE_URL points to. `pnpm test:integration`
# (vitest.integration.setup.ts) aborts unless this looks like a disposable
# dev/test/preview branch.
NEON_BRANCH="dev"

# Only needed if NEON_BRANCH isn't named dev/test/preview but you still
# want to allow `pnpm test:integration` to run against it (it creates and
# deletes real rows) — set it to the exact same value as NEON_BRANCH to
# confirm explicitly. Leave unset otherwise.
NEON_INTEGRATION_TEST_ALLOW_BRANCH=""

# Optional: direct connection to a dedicated `shadow` Neon branch, used only
# by the Prisma CLI to diff the migrations folder (see prisma.config.ts).
# Leave unset otherwise.
SHADOW_DATABASE_URL=""

# Development-only auth bypass (lib/auth/dev-bypass.ts). Honored only when
# NODE_ENV === "development"; ignored in production/test/preview builds.
# Set to a user id to be signed in as that user without going through login.
DEV_AUTH_BYPASS_USER_ID=""

# Web Push (daily reminder). Generate the pair with:
#   pnpm dlx web-push generate-vapid-keys
# The public key is also exposed to the browser (NEXT_PUBLIC_), the private
# key never is. VAPID_SUBJECT is a mailto: or https: contact URL.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret for POST /api/cron/reminders (Authorization: Bearer ...).
# Generate with: openssl rand -hex 32. The same value goes in the GitHub
# repo secret CRON_SECRET used by .github/workflows/reminders-cron.yml.
CRON_SECRET=""

# Comma-separated Neon Auth user ids allowed into /admin (usage metrics).
# Unset or empty = nobody is admin. Admins are also left out of the metrics
# unless "Incluir meus dados" is on.
ADMIN_USER_IDS=""
