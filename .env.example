# Neon connection strings and Auth URLs. `neon deploy` / `neon env pull`
# writes these into .env.local; this file documents them.
#
# DATABASE_URL — pooled connection (host ends in "-pooler"), used by the
# app at runtime through the Neon serverless driver adapter (see lib/db.ts).
DATABASE_URL="postgresql://user:password@ep-example-000000-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# DATABASE_URL_UNPOOLED — direct connection (no "-pooler"), used only by the
# Prisma CLI for migrations (see prisma.config.ts). DIRECT_URL is still
# accepted as a fallback.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example-000000.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon Auth (Managed Better Auth), see lib/auth/server.ts.
NEON_AUTH_BASE_URL="https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"
# Generate with: openssl rand -base64 32 (not injected by Neon)
NEON_AUTH_COOKIE_SECRET=""
